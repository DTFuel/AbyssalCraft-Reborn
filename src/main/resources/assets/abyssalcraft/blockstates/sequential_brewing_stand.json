{
  "multipart": [
    {
      "apply": {
        "model": "minecraft:block/brewing_stand"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "abyssalcraft:block/brewing_stand_pipe"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "abyssalcraft:block/brewing_stand_pipe",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "abyssalcraft:block/brewing_stand_pipe",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "abyssalcraft:block/brewing_stand_pipe",
        "y": 270
      }
    }
  ]
}
